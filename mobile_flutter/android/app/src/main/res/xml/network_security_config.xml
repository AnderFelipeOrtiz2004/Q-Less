<?xml version="1.0" encoding="utf-8"?>
<!-- Permite HTTP (XAMPP) en red local para desarrollo y APK de prueba -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
