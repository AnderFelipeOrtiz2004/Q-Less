# Q-LESS — Variables de entorno (Railway / producción)
# NO subas .env al repositorio. Configura estas variables en Railway.

# --- MySQL (Railway las inyecta al vincular MySQL) ---
# MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE
# O manualmente: DB_HOST, DB_USER, DB_PASS, DB_NAME, DB_PORT=3306, DB_SSL=true

# --- URL pública del API ---
APP_BASE_URL=https://tu-servicio-php.up.railway.app/
# RAILWAY_PUBLIC_DOMAIN=tu-servicio-php.up.railway.app

# --- Admin del sistema (correo ficticio, NO usar Gmail personal) ---
ADMIN_EMAIL=admin@qless.app
ADMIN_PASSWORD=cambiar_password_seguro_en_railway
ADMIN_NAME=Administrador Q-LESS

# --- Correo transaccional: Brevo (recomendado) o Gmail ---
# Brevo: https://www.brevo.com → SMTP & API → SMTP
SMTP_PROVIDER=brevo
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=tu_login_brevo@email.com
SMTP_PASS=clave_smtp_brevo_xsmtpsib
SMTP_FROM=noreply@tudominio-verificado.com
SMTP_FROM_NAME=Q-LESS
# Opcional: Brevo → SMTP y API → Claves API (xkeysib-...). Respaldo si SMTP falla.
# BREVO_API_KEY=xkeysib-tu_clave_api

# Alternativa Gmail (contraseña de aplicación, 16 caracteres sin espacios):
# SMTP_PROVIDER=gmail
# SMTP_HOST=smtp.gmail.com
# SMTP_USER=tu_correo@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# SMTP_FROM=tu_correo@gmail.com

# --- Google Sign-In ---
# Web Client ID (mismo valor en Flutter GOOGLE_WEB_CLIENT_ID)
GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com

# --- App Flutter (opcional: botón "Abrir app" en correos) ---
# URL web de la app o enlace de descarga APK
FLUTTER_APP_URL=https://tu-app.web.app

# --- Chatbot ---
GEMINI_API_KEY=

APP_ENV=production
