# --- Railway / producción ---
# En Railway NO subas .env: usa Variables del servicio BackEnd PHP.

# MySQL (Railway las inyecta al vincular el servicio MySQL)
# MYSQLHOST=
# MYSQLPORT=
# MYSQLUSER=
# MYSQLPASSWORD=
# MYSQLDATABASE=

# O manualmente:
DB_HOST=
DB_USER=
DB_PASS=
DB_NAME=railway
DB_PORT=3306
DB_SSL=true

# URL pública del API PHP (Railway la inyecta como RAILWAY_PUBLIC_DOMAIN)
# APP_BASE_URL=https://tu-servicio-php.up.railway.app/
# RAILWAY_PUBLIC_DOMAIN=tu-servicio-php.up.railway.app

# Admin Q-LESS (solo se crea si no existe; no sobrescribe contraseña existente)
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=cambiar_en_produccion
ADMIN_NAME=Administrador Q-LESS

# Google Sign-In (Web Client ID de Google Cloud Console)
# GOOGLE_CLIENT_ID=

# Chatbot (solo en servidor)
GEMINI_API_KEY=

# Correo Gmail (obligatorio para códigos de verificación y compras aprobadas)
# En Railway: Mobile-API → Variables → agregar estas 5 variables
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=contraseña_de_aplicacion_de_16_caracteres
SMTP_FROM=tu_correo@gmail.com
SMTP_FROM_NAME=Q-LESS

APP_ENV=production
