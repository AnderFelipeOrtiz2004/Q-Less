\b MANUAL DE USUARIO\b0\par
\par
\b Sistema:\b0  Q-LESS - Utiles escolares e insumos academicos\par
\b Documento:\b0  Manual de usuario\par
\b Version del sistema:\b0  2.9.1\par
\b Version del manual:\b0  1.0\par
\b Fecha:\b0  Junio 2026\par
\b Programa de formacion:\b0  Analisis y Desarrollo de Software\par
